{
    "name": "danube/ve-pay-sdk",
    "description": "Polymorphic SDK gateway core for Venezuelan bank APIs",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Danube\\VePaySdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danube\\VePaySdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test-filter": "pest --filter",
        "lint": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "format": "php-cs-fixer fix --allow-risky=yes"
    }
}
